# Environment variables template (placeholders only - no real values or secrets)

# ==============================================================================
# Canonical Site URL
# ==============================================================================
# Production site domain (used for canonical links, sitemaps, and OpenGraph URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Contact Form Delivery (Resend Transactional Email)
# ==============================================================================
# 1. Sign up for a free account at https://resend.com
# 2. Generate an API Key under API Keys in the Resend dashboard
# 3. Store the real values ONLY in .env.local (gitignored) or Vercel Environment Variables
# ------------------------------------------------------------------------------

# Resend API Key (starts with re_)
RESEND_API_KEY=re_your_api_key_here

# The private inbox where visitor contact messages should be delivered
CONTACT_TO_EMAIL=your_inbox@example.com

# Sender email address:
# - On Resend free tier WITHOUT a custom verified domain:
#   Must be 'onboarding@resend.dev' (Note: Resend restricts test deliveries with this
#   sender strictly to the email address registered with your Resend account).
# - WITH a custom verified domain (e.g. yourportfolio.dev):
#   Use 'contact@yourportfolio.dev' or 'noreply@yourportfolio.dev'.
CONTACT_FROM_EMAIL=onboarding@resend.dev
